#!/usr/bin/env bash
# agent-ding — desktop "done" toast for coding agents (turn complete only).
# English-only. Two lines: title + body. Brand icon via dedicated .app + -sender.
#
# Usage: agent-ding <client> [message]
# Clients: claude | grok | agy | codex | <custom>
set -euo pipefail

CLIENT_RAW="${1:-agent}"
shift || true
CUSTOM_MSG="${*:-}"
CLIENT="$(printf '%s' "$CLIENT_RAW" | tr '[:upper:]' '[:lower:]')"

APP_ROOT="${AGENT_DING_APP_DIR:-$HOME/.local/share/agent-ding/apps}"
ICON_DIR="${AGENT_DING_ICON_DIR:-$HOME/.local/share/agent-ding/icons}"
MSG_DONE="${AGENT_DING_MSG_DONE:-Done}"
DEBUG_LOG="${AGENT_DING_DEBUG_LOG:-$HOME/.local/share/agent-ding/debug.log}"

debug() {
  [ "${AGENT_DING_DEBUG:-0}" = "1" ] || return 0
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$DEBUG_LOG" 2>/dev/null || true
}

# Detect which agent host is running this process (hook / tool shell / TUI).
# Grok sets GROK_AGENT=1 on tool shells; Stop hooks also set GROK_HOOK_EVENT,
# GROK_SESSION_ID, GROK_WORKSPACE_ROOT. Claude Code sets CLAUDE_CODE_* vars.
# Walk PPID so nested zsh→bash→grok still matches.
ancestor_is() {
  local needle="$1" p="${PPID:-0}" i=0 comm args
  needle="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  while [ -n "$p" ] && [ "$p" != "0" ] && [ "$i" -lt 12 ]; do
    comm="$(ps -p "$p" -o comm= 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ' || true)"
    args="$(ps -p "$p" -o args= 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    case "$comm $args" in
      *"$needle"*) return 0 ;;
    esac
    p="$(ps -p "$p" -o ppid= 2>/dev/null | tr -d ' ' || true)"
    i=$((i + 1))
  done
  return 1
}

detect_host() {
  # Explicit env from Grok hooks / tool runner (preferred)
  if [ -n "${GROK_HOOK_EVENT:-}" ] || [ -n "${GROK_SESSION_ID:-}" ] \
    || [ -n "${GROK_SESSION:-}" ] || [ -n "${GROK_WORKSPACE_ROOT:-}" ] \
    || [ -n "${GROK_HOME:-}" ] || [ -n "${GROK_AGENT:-}" ] \
    || [ -n "${GROK_HOOK_NAME:-}" ]; then
    printf '%s' "grok"
    return
  fi
  # Claude Code hook / session env
  if [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ] || [ -n "${CLAUDE_CODE_SESSION:-}" ] \
    || [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_SESSION_ID:-}" ] \
    || [ -n "${CLAUDE_CODE_SSE_PORT:-}" ]; then
    # Grok also sets CLAUDE_PROJECT_DIR as a Claude-compat alias — do not
    # treat that alone as Claude host when any GROK_* already matched above.
    printf '%s' "claude"
    return
  fi
  if ancestor_is grok; then
    printf '%s' "grok"
    return
  fi
  if ancestor_is claude; then
    printf '%s' "claude"
    return
  fi
  printf '%s' ""
}

HOST="$(detect_host)"
debug "start client=$CLIENT host=${HOST:-none} ppid=$PPID grok_agent=${GROK_AGENT:-} grok_hook=${GROK_HOOK_EVENT:-} cwd=$PWD"

# If the hook argument disagrees with the real host, trust the host.
# Example: Grok with compat.claude.hooks=true runs "agent-ding claude" → remap to grok.
# Same group key for grok (below) collapses double-fire (claude hook + grok Stop) into one toast.
if [ "$HOST" = "grok" ]; then
  case "$CLIENT" in
    claude|claude-code|cc|agent|"")
      debug "remap $CLIENT → grok (host=grok)"
      CLIENT=grok
      CLIENT_RAW=grok
      ;;
  esac
elif [ "$HOST" = "claude" ]; then
  case "$CLIENT" in
    grok|grok-build|xai)
      debug "remap $CLIENT → claude (host=claude)"
      CLIENT=claude
      CLIENT_RAW=claude
      ;;
  esac
fi

case "$CLIENT" in
  claude|claude-code|cc)
    CLIENT=claude; TITLE="Claude Code"; APP_NAME="Claude"
    SENDER_ID="local.agentding.claude"
    SOUND="${AGENT_DING_SOUND:-Glass}" ;;
  grok|grok-build|xai)
    CLIENT=grok; TITLE="Grok"; APP_NAME="Grok"
    SENDER_ID="local.agentding.grok"
    SOUND="${AGENT_DING_SOUND:-Hero}" ;;
  agy|antigravity|gemini)
    CLIENT=agy; TITLE="Agy"; APP_NAME="Agy"
    SENDER_ID="local.agentding.agy"
    SOUND="${AGENT_DING_SOUND:-Purr}" ;;
  codex)
    CLIENT=codex; TITLE="Codex"; APP_NAME="Codex"
    SENDER_ID="local.agentding.codex"
    SOUND="${AGENT_DING_SOUND:-Submarine}" ;;
  *)
    TITLE="$(printf '%s' "$CLIENT_RAW" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
    APP_NAME=""; SENDER_ID=""; SOUND="${AGENT_DING_SOUND:-Glass}" ;;
esac

PROJECT="$(basename "${PWD:-$HOME}")"
[ "$PROJECT" = "/" ] && PROJECT="Home"
PROJECT_HASH="$(printf '%s' "${PWD:-}" | shasum -a 1 2>/dev/null | awk '{print $1}' | cut -c1-10)"
[ -z "$PROJECT_HASH" ] && PROJECT_HASH="default"
# Group by project only (not client) so a remapped + native double-fire collapses.
GROUP="agent-ding:done:${PROJECT_HASH}"

if [ -n "$CUSTOM_MSG" ]; then
  DETAIL="$(printf '%s' "$CUSTOM_MSG" | tr '\n' ' ' | sed 's/  */ /g; s/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ "${#DETAIL}" -gt 100 ] && DETAIL="${DETAIL:0:97}…"
else
  DETAIL="$MSG_DONE"
fi
BODY="${PROJECT} · ${DETAIL}"

case "${TERM_PROGRAM:-}" in
  ghostty) BUNDLE_ID="com.mitchellh.ghostty" ;;
  iTerm.app) BUNDLE_ID="com.googlecode.iterm2" ;;
  Apple_Terminal) BUNDLE_ID="com.apple.Terminal" ;;
  WezTerm) BUNDLE_ID="com.github.wez.wezterm" ;;
  kitty) BUNDLE_ID="net.kovidgoyal.kitty" ;;
  *) BUNDLE_ID="${AGENT_DING_ACTIVATE:-com.mitchellh.ghostty}" ;;
esac

NOTIFIER=""
if [ -n "$APP_NAME" ] && [ -x "$APP_ROOT/${APP_NAME}.app/Contents/MacOS/terminal-notifier" ]; then
  NOTIFIER="$APP_ROOT/${APP_NAME}.app/Contents/MacOS/terminal-notifier"
elif [ -x /opt/homebrew/bin/terminal-notifier ]; then
  NOTIFIER=/opt/homebrew/bin/terminal-notifier
elif command -v terminal-notifier >/dev/null 2>&1; then
  NOTIFIER="$(command -v terminal-notifier)"
fi

ICON_FILE=""
if [ -n "$CLIENT" ] && [ -f "$ICON_DIR/${CLIENT}.png" ]; then
  ICON_FILE="$ICON_DIR/${CLIENT}.png"
fi

debug "notify title=$TITLE app=$APP_NAME sender=$SENDER_ID notifier=$NOTIFIER body=$BODY"

if [ -n "$NOTIFIER" ]; then
  ARGS=(-title "$TITLE" -message "$BODY" -sound "$SOUND" -group "$GROUP")
  [ -n "$BUNDLE_ID" ] && ARGS+=(-activate "$BUNDLE_ID")
  # Left icon = brand .app via -sender (must match CFBundleIdentifier).
  if [ -n "$SENDER_ID" ]; then
    ARGS+=(-sender "$SENDER_ID")
  fi
  # Do NOT pass -contentImage: modern macOS draws a second large thumbnail
  # on the RIGHT (duplicate / weird app tile). -appIcon only as no-sender fallback.
  if [ -n "$ICON_FILE" ] && [ -z "$SENDER_ID" ]; then
    ARGS+=(-appIcon "file://${ICON_FILE}")
  fi
  "$NOTIFIER" "${ARGS[@]}" >/dev/null 2>&1 || true
elif command -v notify-send >/dev/null 2>&1; then
  notify-send "$TITLE" "$BODY" 2>/dev/null || true
else
  osascript -e "display notification \"${BODY//\"/\\\"}\" with title \"${TITLE//\"/\\\"}\" sound name \"$SOUND\"" >/dev/null 2>&1 || true
fi

if [ "${AGENT_DING_ZELLIJ_MARK:-1}" != "0" ] \
  && [ -n "${ZELLIJ:-}" ] && [ -n "${ZELLIJ_PANE_ID:-}" ] \
  && command -v zellij >/dev/null 2>&1; then
  zellij pipe --name "zellij-attention::completed::$ZELLIJ_PANE_ID" >/dev/null 2>&1 || true
fi

if [ "${AGENT_DING_BELL:-1}" != "0" ]; then
  { [ -e /dev/tty ] && printf '\a' >/dev/tty || printf '\a'; } 2>/dev/null || true
fi

exit 0
