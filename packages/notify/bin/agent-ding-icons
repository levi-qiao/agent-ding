#!/bin/bash
# Download brand marks + composite agent-ding icons (official look).
set -euo pipefail
ICON_DIR="${AGENT_DING_ICON_DIR:-$HOME/.local/share/agent-ding/icons}"
OFFICIAL="$ICON_DIR/official"
mkdir -p "$OFFICIAL" "$ICON_DIR"

dl() {
  local out="$1" url="$2"
  curl -fsSL -L -o "$out" "$url"
}

echo "downloading brand assets…"
dl "$OFFICIAL/claude.png" "https://raw.githubusercontent.com/lobehub/lobe-icons/master/packages/static-png/dark/claude.png"
dl "$OFFICIAL/grok.png" "https://raw.githubusercontent.com/lobehub/lobe-icons/master/packages/static-png/dark/grok.png"
dl "$OFFICIAL/openai.png" "https://raw.githubusercontent.com/lobehub/lobe-icons/master/packages/static-png/dark/openai.png"
dl "$OFFICIAL/antigravity.png" "https://antigravity.google/assets/image/brand/antigravity-icon__full-color.png" \
  || dl "$OFFICIAL/antigravity.png" "https://raw.githubusercontent.com/lobehub/lobe-icons/master/packages/static-png/dark/gemini-color.png"

export AGENT_DING_ICON_DIR="$ICON_DIR"
export AGENT_DING_OFFICIAL_DIR="$OFFICIAL"
swift - <<'SWIFT'
import AppKit
import Foundation

let iconDir = ProcessInfo.processInfo.environment["AGENT_DING_ICON_DIR"]!
let official = ProcessInfo.processInfo.environment["AGENT_DING_OFFICIAL_DIR"]!
let size: CGFloat = 1024
let pad: CGFloat = 170

func load(_ name: String) -> NSImage? {
  NSImage(contentsOfFile: (official as NSString).appendingPathComponent(name))
}

func writeIcon(out: String, logo: NSImage, bg: NSColor, forceWhite: Bool) {
  let canvas = NSImage(size: NSSize(width: size, height: size))
  canvas.lockFocus()
  let path = NSBezierPath(roundedRect: NSRect(x: 24, y: 24, width: size-48, height: size-48), xRadius: 220, yRadius: 220)
  bg.setFill(); path.fill()
  let ls = logo.size
  let maxW = size - pad * 2
  let maxH = size - pad * 2
  let scale = min(maxW / max(ls.width, 1), maxH / max(ls.height, 1))
  let w = ls.width * scale
  let h = ls.height * scale
  let dest = NSRect(x: (size - w) / 2, y: (size - h) / 2, width: w, height: h)
  if forceWhite {
    let tinted = NSImage(size: dest.size)
    tinted.lockFocus()
    NSColor.white.setFill()
    NSRect(origin: .zero, size: dest.size).fill()
    logo.draw(in: NSRect(origin: .zero, size: dest.size), from: .zero, operation: .destinationIn, fraction: 1)
    tinted.unlockFocus()
    tinted.draw(in: dest, from: .zero, operation: .sourceOver, fraction: 1)
  } else {
    logo.draw(in: dest, from: .zero, operation: .sourceOver, fraction: 1, respectFlipped: true,
              hints: [.interpolation: NSImageInterpolation.high])
  }
  canvas.unlockFocus()
  let tiff = canvas.tiffRepresentation!
  let rep = NSBitmapImageRep(data: tiff)!
  let png = rep.representation(using: .png, properties: [:])!
  try! png.write(to: URL(fileURLWithPath: (iconDir as NSString).appendingPathComponent(out)))
  print("wrote \(out)")
}

if let logo = load("claude.png") {
  writeIcon(out: "claude.png", logo: logo,
            bg: NSColor(srgbRed: 0.85, green: 0.47, blue: 0.34, alpha: 1), forceWhite: true)
}
if let logo = load("grok.png") {
  writeIcon(out: "grok.png", logo: logo,
            bg: NSColor(srgbRed: 0.05, green: 0.05, blue: 0.06, alpha: 1), forceWhite: false)
}
if let logo = load("antigravity.png") {
  writeIcon(out: "agy.png", logo: logo,
            bg: NSColor(srgbRed: 0.10, green: 0.11, blue: 0.14, alpha: 1), forceWhite: false)
}
if let logo = load("openai.png") {
  writeIcon(out: "codex.png", logo: logo,
            bg: NSColor(srgbRed: 0.06, green: 0.06, blue: 0.07, alpha: 1), forceWhite: false)
}
SWIFT

echo "icons → $ICON_DIR"
echo "run: agent-ding-build-apps"
