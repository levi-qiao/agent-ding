# agent-ding recommended Ghostty settings
# Merge into: ~/Library/Application Support/com.mitchellh.ghostty/config
#             or ~/.config/ghostty/config

# Prefer agent-ding branded toasts over OSC desktop notifications
desktop-notifications = false

# Bell when long shell commands finish (unfocused)
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell
notify-on-command-finish-after = 10s

macos-option-as-alt = true
